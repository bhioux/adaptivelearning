# Server
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Database (Neon Postgres). Local: docker-compose up -d postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptivelearning?schema=public

# Redis (Upstash or local). Local: docker-compose up -d redis
REDIS_URL=redis://localhost:6379

# Auth (change in production!)
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Observability
OTEL_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Billing (filled at production onboarding)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI sidecar (Python, Phase 4)
AI_SIDECAR_URL=http://localhost:8010

# Dev seed accounts
SEED_PASSWORD=adaptivelearning-dev-pass
